---
// src/layouts/Layout.astro
interface Props {
	title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="ja">
	<head>
		<meta charset="UTF-8" />
		<meta name="description" content="湖明荘オートキャンプ場" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<title>{title}</title>
	</head>
	<body>
		<slot /> <!-- ここに各ページの中身が入ります -->
	</body>
</html>

<style is:global>
	html {
		font-family: system-ui, sans-serif;
		background: #fdfdfd;
		color: #2c3e50;
	}
	body {
		margin: 0;
	}
</style>